function applyFormSettings_(form, description) {
  form.setDescription(description);
  form.setConfirmationMessage('Saved.');
  form.setAllowResponseEdits(false);
  form.setPublishingSummary(false);
  form.setShowLinkToRespondAgain(false);
  form.setProgressBar(false);
  form.setCollectEmail(false);
}

/** Adds the given field definitions to the end of a form. */
function addFields_(form, defs) {
  const pages = {};
  const routed = [];
  defs.forEach(function (f) {
    if (f.type === 'page') {
      const pb = form.addPageBreakItem().setTitle(f.title);
      if (f.help) pb.setHelpText(f.help);
      pages[f.id] = pb;
      return;
    }
    let item;
    switch (f.type) {
      case 'scale':
        item = form.addScaleItem().setBounds(f.min, f.max).setLabels(f.low || '', f.high || '');
        break;
      case 'choice': item = form.addMultipleChoiceItem(); break;
      case 'checkbox': item = form.addCheckboxItem(); break;
      case 'paragraph': item = form.addParagraphTextItem(); break;
      case 'text':
        item = form.addTextItem();
        if (f.number) {
          item.setValidation(FormApp.createTextValidation()
            .setHelpText('Enter a number from ' + f.number[0] + ' to ' + f.number[1] + '.')
            .requireNumberBetween(f.number[0], f.number[1])
            .build());
        }
        break;
      default: throw new Error('Unknown field type: ' + f.type);
    }
    item.setTitle(f.title);
    if (f.help) item.setHelpText(f.help);
    item.setRequired(!!f.required);
    if (f.type === 'choice' || f.type === 'checkbox') {
      const hasRoute = f.choices.some(function (c) { return c.goTo; });
      if (hasRoute) routed.push({ item: item, f: f });
      else item.setChoiceValues(f.choices.map(function (c) { return c.label; }));
    }
  });
  // Routed choices are set last so the page they point to already exists.
  routed.forEach(function (r) {
    r.item.setChoices(r.f.choices.map(function (c) {
      if (c.goTo === 'submit') return r.item.createChoice(c.label, FormApp.PageNavigationType.SUBMIT);
      if (c.goTo && pages[c.goTo]) return r.item.createChoice(c.label, pages[c.goTo]);
      return r.item.createChoice(c.label);
    }));
  });
}

function createCheckinForm_(signNames) {
  const form = FormApp.create('Check-in');
  applyFormSettings_(form, 'Mood, sleep, medication. The detail page is optional.');
  addFields_(form, checkinFields_(signNames));
  return form;
}

function createSpikeForm_() {
  const form = FormApp.create('Log a spike');
  applyFormSettings_(form, 'Use when it happens. Not a daily form.');
  addFields_(form, spikeFields_());
  return form;
}

function formTitles_(form) {
  const t = {};
  form.getItems().forEach(function (it) { t[it.getTitle()] = it; });
  return t;
}

/**
 * Appends fields the form does not have yet and syncs the signs checklist
 * with the Config tab. Run from Journal > Update forms.
 * Returns a short report string.
 */
function updateForms() {
  const ss = getSS_();
  const props = PropertiesService.getScriptProperties();
  const cfg = readConfig_(ss);
  const signNames = checklistSigns_(cfg.signs);
  const report = [];

  const ciId = props.getProperty(PROP.FORM_CHECKIN_ID);
  if (ciId) {
    const form = FormApp.openById(ciId);
    const have = formTitles_(form);
    const missing = checkinFields_(signNames).filter(function (f) { return f.type !== 'page' && f.id !== 'signs' && !have[f.title]; });
    if (missing.length) addFields_(form, missing);
    report.push('Check-in form: ' + missing.length + ' field(s) added.');
    report.push(syncSignsChecklist_(form, signNames));
  }
  const gId = props.getProperty(PROP.FORM_SPIKE_ID);
  if (gId) {
    const form = FormApp.openById(gId);
    const have = formTitles_(form);
    const missing = spikeFields_().filter(function (f) { return !have[f.title]; });
    if (missing.length) addFields_(form, missing);
    report.push('Spike form: ' + missing.length + ' field(s) added.');
  }
  const text = report.join('\n');
  try { SpreadsheetApp.getUi().alert('Update forms', text, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) { /* no UI */ }
  return text;
}

/** Sets the "Signs I noticed" checkbox choices from the Config tab. */
function syncSignsChecklist_(form, signNames) {
  const have = formTitles_(form);
  const item = have[HEADERS.signs];
  if (!signNames.length) {
    return item ? 'Signs checklist: Config has no "Checklist tick" signs. The form item was left as it is.' : 'Signs checklist: none configured.';
  }
  if (item) {
    item.asCheckboxItem().setChoiceValues(signNames);
    return 'Signs checklist: updated to ' + signNames.length + ' item(s).';
  }
  addFields_(form, [{
    id: 'signs', type: 'checkbox', title: HEADERS.signs, help: 'The list comes from the Config tab.',
    choices: signNames.map(function (l) { return { label: l }; }), required: false
  }]);
  return 'Signs checklist: added with ' + signNames.length + ' item(s).';
}

/** Unique sign names that use the checklist, in Config order. */
function checklistSigns_(signs) {
  const seen = {};
  const out = [];
  signs.forEach(function (s) {
    if (s.detector === DETECTORS.CHECKLIST && !seen[s.sign]) { seen[s.sign] = true; out.push(s.sign); }
  });
  return out;
}

// ---- Sheet.gs ----
/**
 * Spreadsheet helpers and the static tabs (Config, Baseline).
 * Pattern and Daily are written by Refresh.gs.
 */

/** The journal spreadsheet. Uses the stored ID so triggers and web apps find it too. */
function getSS_() {
  const id = PropertiesService.getScriptProperties().getProperty(PROP.SHEET_ID);
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function getOrCreateSheet_(ss, name) {
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function styleHeader_(range) {
  range.setFontWeight('bold').setBackground('#F1F3F5').setFontColor('#1B1F23');
}

function styleTable_(range) {
  range.setBorder(true, true, true, true, true, true, '#D5D9DD', SpreadsheetApp.BorderStyle.SOLID);
}

/** Config tab. Written once. Existing cells are never overwritten, only missing settings are added. */
function buildConfigTab_(ss) {
  let sh = ss.getSheetByName(TABS.CONFIG);
  const fresh = !sh;
  if (!sh) sh = ss.insertSheet(TABS.CONFIG);
  const L = CFG_LAYOUT;

  sh.getRange('A1').setValue('Config').setFontSize(18).setFontWeight('bold');
  sh.getRange('A2').setValue('The warning signature and the response steps live here. The rows below are examples. Replace them with your own. Response steps are blank on purpose.');
  sh.getRange('A3').setValue('Do not insert rows above the tables. Add signs in the empty rows of the Signs table.');
  sh.getRange('A2:A3').setFontColor('#565F68');

  sh.getRange(L.signsLabelRow, 1).setValue('Signs').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.signsHeaderRow, 1, 1, 5).setValues([['Tier', 'Sign', 'Detected by', 'Detail', 'Note']]);
  styleHeader_(sh.getRange(L.signsHeaderRow, 1, 1, 5));
  styleTable_(sh.getRange(L.signsHeaderRow, 1, L.signsRows + 1, 5));

  sh.getRange(L.stepsLabelRow, 1).setValue('Response steps').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.stepsHeaderRow, 1, 1, 2).setValues([['Tier', 'Step']]);
  styleHeader_(sh.getRange(L.stepsHeaderRow, 1, 1, 2));
  sh.getRange(L.stepsFirstRow, 1, 3, 1).setValues([['Early'], ['Middle'], ['Late']]);
  styleTable_(sh.getRange(L.stepsHeaderRow, 1, 4, 2));
  sh.getRange(L.stepsFirstRow, 2, 3, 1).setWrap(true);
  sh.getRange(L.stepsFirstRow + 3, 1).setValue('Left blank. Write these with your clinician.').setFontColor('#565F68');

  sh.getRange(L.settingsLabelRow, 2).setValue('Settings').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.settingsHeaderRow, 2, 1, 2).setValues([['Setting', 'Value']]);
  styleHeader_(sh.getRange(L.settingsHeaderRow, 2, 1, 2));

  if (fresh) {
    sh.getRange(L.signsFirstRow, 1, SEED_SIGNS.length, 5).setValues(SEED_SIGNS);
  }
  ensureSettings_(sh);
  styleTable_(sh.getRange(L.settingsHeaderRow, 2, SETTINGS.length + 1, 2));

  const tierRule = SpreadsheetApp.newDataValidation().requireValueInList(TIERS, true).setAllowInvalid(false).build();
  sh.getRange(L.signsFirstRow, 1, L.signsRows, 1).setDataValidation(tierRule);
  const detectorRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(Object.keys(DETECTORS).map(function (k) { return DETECTORS[k]; }), true)
    .setAllowInvalid(false).build();
  sh.getRange(L.signsFirstRow, 3, L.signsRows, 1).setDataValidation(detectorRule);

  const onOff = SpreadsheetApp.newDataValidation().requireValueInList(['On', 'Off'], true).setAllowInvalid(false).build();
  SETTINGS.forEach(function (s, i) {
    if (s.key === 'keywordScan') sh.getRange(L.settingsFirstRow + i, 3).setDataValidation(onOff);
  });

  sh.setColumnWidth(1, 90);
  sh.setColumnWidth(2, 340);
  sh.setColumnWidth(3, 200);
  sh.setColumnWidth(4, 260);
  sh.setColumnWidth(5, 260);
  sh.setHiddenGridlines(true);
  return sh;
}

/** Adds any setting whose label is not in the Settings table yet. */
function ensureSettings_(sh) {
  const L = CFG_LAYOUT;
  const span = SETTINGS.length + 20;
  // Text format first, so a value like 04:00 is stored as text and not converted to a time.
  sh.getRange(L.settingsFirstRow, 3, span, 1).setNumberFormat('@');
  const labels = sh.getRange(L.settingsFirstRow, 2, span, 1).getValues().map(function (r) { return String(r[0]).trim(); });
  SETTINGS.forEach(function (s) {
    if (labels.indexOf(s.label) !== -1) return;
    const slot = labels.indexOf('');
    if (slot === -1) return;
    labels[slot] = s.label;
    sh.getRange(L.settingsFirstRow + slot, 2, 1, 2).setValues([[s.label, String(s.value)]]);
  });
}

/** Writes one setting value by key. Returns false if the label is not found. */
function setSetting_(ss, key, value) {
  const sh = ss.getSheetByName(TABS.CONFIG);
  if (!sh) return false;
  const def = SETTINGS.filter(function (s) { return s.key === key; })[0];
  if (!def) return false;
  const L = CFG_LAYOUT;
  const labels = sh.getRange(L.settingsFirstRow, 2, SETTINGS.length + 20, 1).getValues();
  for (let i = 0; i < labels.length; i++) {
    if (String(labels[i][0]).trim() === def.label) {
      sh.getRange(L.settingsFirstRow + i, 3).setNumberFormat('@').setValue(String(value));
      return true;
    }
  }
  return false;
}

/** Baseline tab: pinned text written while clear-headed. Never overwritten once the tab exists. */
function buildBaselineTab_(ss) {
  if (ss.getSheetByName(TABS.BASELINE)) return ss.getSheetByName(TABS.BASELINE);
  const sh = ss.insertSheet(TABS.BASELINE);
  sh.getRange('A1').setValue('Baseline').setFontSize(18).setFontWeight('bold');
  sh.getRange('A2').setValue('Written when clear-headed. Pinned here to read.').setFontColor('#565F68');
  sh.getRange('A4').setValue('Written on [date]').setFontColor('#565F68');
  sh.getRange('A5').setValue('[Paste your text here.]').setFontSize(14).setWrap(true).setVerticalAlignment('top');
  sh.setColumnWidth(1, 760);
  sh.setRowHeight(5, 320);
  sh.setHiddenGridlines(true);
  return sh;
}

/** Puts the tabs in a fixed order. Missing tabs are skipped. */
function orderTabs_(ss) {
  const order = [TABS.CHECKINS, TABS.SPIKES, TABS.DAILY, TABS.DEVICE, TABS.PATTERN, TABS.CONFIG, TABS.BASELINE, TABS.CHART];
  let pos = 1;
  order.forEach(function (name) {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    ss.setActiveSheet(sh);
    ss.moveActiveSheet(pos);
    pos++;
  });
  const pattern = ss.getSheetByName(TABS.PATTERN);
  if (pattern) ss.setActiveSheet(pattern);
}

/** Removes the default empty "Sheet1" if other tabs exist. */
function removeDefaultSheet_(ss) {
  const sh = ss.getSheetByName('Sheet1');
  if (sh && ss.getSheets().length > 1 && sh.getLastRow() === 0 && sh.getLastColumn() === 0) ss.deleteSheet(sh);
}

// ---- Refresh.gs ----
/**
 * Reads the raw tabs, runs the Logic, writes Daily and Pattern.
 * Raw tabs (Check-ins, Spikes, Device) are never modified here.
 */

function refreshAll() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another refresh is running. Try again in a moment.');
  try {
    const data = loadAll_();
    writeDaily_(data);
    writePattern_(data);
    return data;
  } finally {
    lock.releaseLock();
  }
}

function refreshFromMenu() {
  refreshAll();
  getSS_().toast('Daily and Pattern refreshed.', 'Journal', 4);
}

/** Runs on every form submission. */
function handleFormSubmit() {
  try { refreshAll(); } catch (err) { console.error(String(err)); }
}

// ---------- reading ----------

function readTable_(sheet, display) {
  if (!sheet || sheet.getLastRow() < 2) return { idx: {}, rows: [] };
  const range = sheet.getDataRange();
  const values = display ? range.getDisplayValues() : range.getValues();
  const idx = {};
  values[0].forEach(function (h, i) { idx[String(h).trim()] = i; });
  return { idx: idx, rows: values.slice(1) };
}

function cell_(t, row, header) {
  const i = t.idx[header];
  return i === undefined ? '' : row[i];
}

function str_(v) { return v === null || v === undefined ? '' : String(v).trim(); }

/** The categorical check-in answers for one row, keyed by question title. Blanks are left out. */
function answers_(t, row) {
  const out = {};
  ANSWER_KEYS.forEach(function (k) {
    const v = str_(cell_(t, row, HEADERS[k]));
    if (v) out[HEADERS[k]] = v;
  });
  return out;
}

function readCheckins_(ss, rolloverHours, fmt) {
  const t = readTable_(ss.getSheetByName(TABS.CHECKINS), false);
  const out = [];
  t.rows.forEach(function (row) {
    const ts = cell_(t, row, HEADERS.timestamp);
    if (!(ts instanceof Date)) return;
    out.push({
      ts: ts,
      date: dateKey(ts, rolloverHours, fmt),
      mood: cell_(t, row, HEADERS.mood),
      sleep: cell_(t, row, HEADERS.sleep),
      med: str_(cell_(t, row, HEADERS.med)),
      energy: cell_(t, row, HEADERS.energy),
      answers: answers_(t, row),
      subst: str_(cell_(t, row, HEADERS.substances)),
      signsText: str_(cell_(t, row, HEADERS.signs)),
      note: str_(cell_(t, row, HEADERS.note)),
      share: str_(cell_(t, row, HEADERS.share)) === VAL.YES
    });
  });
  return out;
}

function readSpikes_(ss, rolloverHours, fmt) {
  const t = readTable_(ss.getSheetByName(TABS.SPIKES), false);
  const out = [];
  t.rows.forEach(function (row) {
    const ts = cell_(t, row, HEADERS.timestamp);
    if (!(ts instanceof Date)) return;
    out.push({
      ts: ts,
      date: dateKey(ts, rolloverHours, fmt),
      kind: str_(cell_(t, row, HEADERS.s_kind)),
      what: str_(cell_(t, row, HEADERS.s_what)),
      intensity: cell_(t, row, HEADERS.s_intensity),
      event: cell_(t, row, HEADERS.s_event),
      fact: str_(cell_(t, row, HEADERS.s_fact)),
      frame: str_(cell_(t, row, HEADERS.s_frame)),
      replay: str_(cell_(t, row, HEADERS.s_replay)),
      debt: str_(cell_(t, row, HEADERS.s_debt)),
      hopeless: str_(cell_(t, row, HEADERS.s_hopeless)),
      urge: str_(cell_(t, row, HEADERS.s_urge))
    });
  });
  return out;
}

function readDevice_(ss) {
  const sh = ss.getSheetByName(TABS.DEVICE);
  if (!sh) return [];
  const t = readTable_(sh, true);
  const H = DEVICE_HEADERS;
  const out = [];
  t.rows.forEach(function (row) {
    const date = str_(cell_(t, row, H.date));
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return;
    out.push({
      date: date,
      sleep: str_(cell_(t, row, H.sleep)),
      bed: str_(cell_(t, row, H.bed)),
      wake: str_(cell_(t, row, H.wake)),
      steps: str_(cell_(t, row, H.steps)),
      exercise: str_(cell_(t, row, H.exercise))
    });
  });
  return out;
}

function capTier_(v) {
  const s = str_(v).toLowerCase();
  for (let i = 0; i < TIERS.length; i++) { if (TIERS[i].toLowerCase() === s) return TIERS[i]; }
  return '';
}

function readConfig_(ss) {
  const out = { settings: normalizeSettings({}), signs: [], steps: {} };
  const sh = ss.getSheetByName(TABS.CONFIG);
  if (!sh) return out;
  const L = CFG_LAYOUT;
  sh.getRange(L.signsFirstRow, 1, L.signsRows, 5).getDisplayValues().forEach(function (r) {
    const tier = capTier_(r[0]);
    const sign = str_(r[1]);
    const detector = str_(r[2]);
    if (tier && sign && detector) out.signs.push({ tier: tier, sign: sign, detector: detector, detail: str_(r[3]) });
  });
  sh.getRange(L.stepsFirstRow, 1, 3, 2).getDisplayValues().forEach(function (r) { out.steps[str_(r[0])] = str_(r[1]); });
  const last = Math.max(sh.getLastRow(), L.settingsFirstRow);
  const raw = {};
  sh.getRange(L.settingsFirstRow, 2, last - L.settingsFirstRow + 1, 2).getDisplayValues().forEach(function (r) {
    const label = str_(r[0]);
    SETTINGS.forEach(function (s) { if (s.label === label) raw[s.key] = str_(r[1]); });
  });
  out.settings = normalizeSettings(raw);
  return out;
}

function loadAll_() {
  const ss = getSS_();
  const tz = ss.getSpreadsheetTimeZone();
  const cfg = readConfig_(ss);
  const fmt = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); };
  const rh = cfg.settings.rolloverHours;
  const checkins = readCheckins_(ss, rh, fmt);
  const spikes = readSpikes_(ss, rh, fmt);
  const device = readDevice_(ss);
  const today = dateKey(new Date(), rh, fmt);
  const daily = buildDaily({ checkins: checkins, spikes: spikes, device: device, signs: cfg.signs }, cfg.settings, today);
  return { ss: ss, tz: tz, cfg: cfg, checkins: checkins, spikes: spikes, device: device, today: today, daily: daily };
}

