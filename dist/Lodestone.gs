// ---- Logic.gs ----
/**
 * Pure logic. No Apps Script services are used here, so this file runs
 * under Node for tests (see test/logic.test.js). Dates are 'YYYY-MM-DD'
 * strings. The sheet layer converts timestamps to date strings before
 * calling anything in this file.
 */

const MONTHS_ = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function pad2_(n) { return n < 10 ? '0' + n : String(n); }

function parseISO_(s) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s));
  if (!m) return NaN;
  return Date.UTC(+m[1], +m[2] - 1, +m[3]);
}

function fmtISO_(ms) {
  const d = new Date(ms);
  return d.getUTCFullYear() + '-' + pad2_(d.getUTCMonth() + 1) + '-' + pad2_(d.getUTCDate());
}

function addDays(s, n) { return fmtISO_(parseISO_(s) + n * 86400000); }

function daysBetween(a, b) { return Math.round((parseISO_(b) - parseISO_(a)) / 86400000); }

function labelDate(s) {
  const m = /^\d{4}-(\d{2})-(\d{2})$/.exec(String(s));
  return m ? MONTHS_[+m[1] - 1] + ' ' + (+m[2]) : String(s);
}

/**
 * Date a timestamp counts toward. Entries before the rollover hour count
 * toward the previous day. fmt(Date) -> 'YYYY-MM-DD' is supplied by the caller
 * so the time zone is handled outside this file.
 */
function dateKey(ts, rolloverHours, fmt) {
  return fmt(new Date(ts.getTime() - rolloverHours * 3600000));
}

function num_(v) {
  if (v === '' || v === null || v === undefined) return null;
  const n = Number(v);
  return isFinite(n) ? n : null;
}

/** 'HH:MM' -> clock hours, with after-midnight times as 24+ so late bedtimes sort after early ones. */
function clockHours(hhmm) {
  const m = /^(\d{1,2}):(\d{2})/.exec(String(hhmm === null || hhmm === undefined ? '' : hhmm).trim());
  if (!m) return null;
  const h = +m[1], mi = +m[2];
  if (h > 23 || mi > 59) return null;
  let v = h + mi / 60;
  if (h < 12) v += 24;
  return v;
}

function parseHour_(s) {
  const m = /^(\d{1,2})(?::(\d{2}))?/.exec(String(s).trim());
  if (!m) return 4;
  const v = +m[1] + (m[2] ? +m[2] / 60 : 0);
  return v >= 0 && v <= 12 ? v : 4;
}

/** raw: { key: stringValue } as read from the Config tab. Returns typed settings with defaults. */
function normalizeSettings(raw) {
  const out = {};
  SETTINGS.forEach(function (s) {
    let v = raw && raw[s.key] !== undefined && raw[s.key] !== '' ? raw[s.key] : s.value;
    if (typeof s.value === 'number') {
      v = Number(v);
      if (!isFinite(v) || v <= 0) v = s.value;
    }
    out[s.key] = v;
  });
  out.rolloverHours = parseHour_(out.rollover);
  out.keywordScanOn = String(out.keywordScan).toLowerCase() === 'on';
  out.deviceImportOn = String(out.deviceImport).toLowerCase() === 'on';
  return out;
}

/** Mean of the `win` days before index i. Needs `win` days of history and at least half of them filled. */
function rollingMean(arr, i, win) {
  if (i < win) return null;
  let sum = 0, count = 0;
  for (let k = i - win; k < i; k++) {
    if (arr[k] !== null && arr[k] !== undefined) { sum += arr[k]; count++; }
  }
  return count >= Math.ceil(win / 2) ? sum / count : null;
}

/** Median of up to `win` days before index i. Needs 30 days of history and at least 15 values. */
function rollingMedian(arr, i, win) {
  const minHistory = 30;
  if (i < minHistory) return null;
  const vals = [];
  for (let k = Math.max(0, i - win); k < i; k++) {
    if (arr[k] !== null && arr[k] !== undefined) vals.push(arr[k]);
  }
  if (vals.length < Math.ceil(minHistory / 2)) return null;
  vals.sort(function (a, b) { return a - b; });
  const m = Math.floor(vals.length / 2);
  return vals.length % 2 ? vals[m] : (vals[m - 1] + vals[m]) / 2;
}

function escapeRegex_(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

/** Whole-word, case-insensitive match of any comma-separated keyword. */
function keywordHit(detail, blob) {
  const words = String(detail || '').split(',').map(function (w) { return w.trim(); }).filter(Boolean);
  for (let k = 0; k < words.length; k++) {
    const re = new RegExp('(^|[^a-z0-9])' + escapeRegex_(words[k]) + '($|[^a-z0-9])', 'i');
    if (re.test(blob)) return true;
  }
  return false;
}

/**
 * "Field: value1, value2" matches when the day's answer to that field equals
 * any listed value (case-insensitive). The field name is a form question title.
 */
function answerHit(detail, fields) {
  const text = String(detail || '');
  const cut = text.indexOf(':');
  if (cut < 0) return false;
  const field = text.slice(0, cut).trim().toLowerCase();
  const wanted = text.slice(cut + 1).split(',').map(function (v) { return v.trim().toLowerCase(); }).filter(Boolean);
  const keys = Object.keys(fields || {});
  for (let i = 0; i < keys.length; i++) {
    if (keys[i].toLowerCase() === field && wanted.indexOf(String(fields[keys[i]]).toLowerCase()) !== -1) return true;
  }
  return false;
}

/** True when any listed kind (comma separated, case-insensitive) matches a spike kind logged that day. */
function kindHit(detail, kinds) {
  const wanted = String(detail || '').split(',').map(function (v) { return v.trim().toLowerCase(); }).filter(Boolean);
  return (kinds || []).some(function (k) { return wanted.indexOf(String(k).toLowerCase()) !== -1; });
}

/**
 * input: {
 *   checkins: [{ts:Date, date, mood, sleep, med, energy, answers:{<title>: value}, subst, signsText, note, share}],
 *   spikes:   [{ts:Date, date, what, kind, intensity, event, fact, frame, replay, debt, hopeless, urge}],
 *   device:   [{date, sleep, bed, wake, steps, exercise}],
 *   signs:    [{tier, sign, detector, detail}]
 * }
 * S: normalized settings. todayStr: last day to include (blank days up to today).
 * Returns { rows, start, end }. One row per calendar date. Days with no
 * entry stay blank.
 */
function buildDaily(input, S, todayStr) {
  const checkins = (input.checkins || []).slice().sort(function (a, b) { return a.ts - b.ts; });
  const spikes = input.spikes || [];
  const device = input.device || [];
  const signRows = input.signs || [];

  const byDate = {};
  function slot(d) { return byDate[d] || (byDate[d] = { entries: [], spikes: [], device: {} }); }
  checkins.forEach(function (c) { slot(c.date).entries.push(c); });
  spikes.forEach(function (g) { slot(g.date).spikes.push(g); });
  device.forEach(function (r) {
    const s = slot(r.date);
    ['sleep', 'bed', 'wake', 'steps', 'exercise'].forEach(function (k) {
      if (r[k] !== undefined && r[k] !== null && r[k] !== '') s.device[k] = r[k];
    });
  });

  const dates = Object.keys(byDate).filter(function (d) { return !isNaN(parseISO_(d)); }).sort();
  if (!dates.length) return { rows: [], start: null, end: null };
  const start = dates[0];
  let end = dates[dates.length - 1];
  if (todayStr && todayStr > end) end = todayStr;
  const n = Math.min(daysBetween(start, end) + 1, 3660);

  const ser = { mood: [], sleep: [], energy: [], steps: [], exercise: [], bed: [] };
  const rows = [];

  for (let i = 0; i < n; i++) {
    const d = addDays(start, i);
    const s = byDate[d] || { entries: [], spikes: [], device: {} };
    const r = {
      date: d, entries: s.entries.length,
      mood: null, sleepSelf: null, med: '', energy: null, subst: '', fields: {}
    };
    const texts = [];
    let checklistText = '';
    s.entries.forEach(function (e) {
      const mood = num_(e.mood); if (mood !== null) r.mood = mood;
      const sl = num_(e.sleep); if (sl !== null) r.sleepSelf = sl;
      if (e.med) r.med = e.med;
      const en = num_(e.energy); if (en !== null) r.energy = en;
      Object.keys(e.answers || {}).forEach(function (title) {
        if (e.answers[title]) r.fields[title] = e.answers[title];
      });
      if (e.subst) r.subst = e.subst;
      if (e.signsText) checklistText += ' | ' + e.signsText;
      if (e.note) texts.push(e.note);
    });
    s.spikes.forEach(function (g) { if (g.what) texts.push(g.what); });

    const dv = s.device;
    r.sleepDev = num_(dv.sleep);
    r.bedText = dv.bed ? String(dv.bed) : '';
    r.wakeText = dv.wake ? String(dv.wake) : '';
    r.bedClock = clockHours(r.bedText);
    r.wakeClock = clockHours(r.wakeText);
    r.steps = num_(dv.steps);
    r.exercise = num_(dv.exercise);
    r.sleepPrimary = r.sleepSelf !== null ? r.sleepSelf : r.sleepDev;

    r._checklistText = checklistText;
    r._blob = texts.join(' \n ').toLowerCase();
    r.speed = r.fields[HEADERS.speed] || '';
    r.appetite = r.fields[HEADERS.appetite] || '';
    r._s = {
      kinds: s.spikes.map(function (g) { return g.kind; }),
      replay: s.spikes.some(function (g) { return g.replay === VAL.YES; }),
      verdict: s.spikes.some(function (g) { return g.frame === VAL.FRAME_VERDICT; }),
      debt: s.spikes.some(function (g) { return g.debt === VAL.YES; }),
      hopeless: s.spikes.some(function (g) { return g.hopeless === VAL.YES; }),
      urge: s.spikes.some(function (g) { return g.urge === VAL.YES; })
    };

    ser.mood.push(r.mood);
    ser.sleep.push(r.sleepPrimary);
    ser.energy.push(r.energy);
    ser.steps.push(r.steps);
    ser.exercise.push(r.exercise);
    ser.bed.push(r.bedClock);
    rows.push(r);
  }

  // Baselines: each day against the days before it.
  const keys = ['mood', 'sleep', 'energy', 'steps', 'exercise', 'bed'];
  rows.forEach(function (r, i) {
    r.base = {};
    r.ref = {};
    keys.forEach(function (k) {
      r.base[k] = rollingMean(ser[k], i, S.baselineDays);
      r.ref[k] = k === 'bed' ? null : rollingMedian(ser[k], i, S.longDays);
    });
  });

  function consecutive(i, count, test) {
    const c = Math.max(1, Math.round(count));
    if (i - c + 1 < 0) return false;
    for (let k = 0; k < c; k++) { if (!test(i - k)) return false; }
    return true;
  }
  const EPS = 1e-9;

  rows.forEach(function (r, i) {
    const auto = {};
    auto.sleep = consecutive(i, S.sleepDriftNights, function (j) {
      const v = ser.sleep[j], b = rows[j].base.sleep;
      return v !== null && b !== null && v <= b - S.sleepDriftHours + EPS;
    });
    auto.moodUp = consecutive(i, S.moodShiftDays, function (j) {
      const v = ser.mood[j], b = rows[j].base.mood;
      return v !== null && b !== null && v - b >= S.moodShift - EPS;
    });
    auto.moodDown = consecutive(i, S.moodShiftDays, function (j) {
      const v = ser.mood[j], b = rows[j].base.mood;
      return v !== null && b !== null && b - v >= S.moodShift - EPS;
    });
    auto.oversleep = consecutive(i, S.sleepDriftNights, function (j) {
      const v = ser.sleep[j], b = rows[j].base.sleep;
      return v !== null && b !== null && v >= b + S.sleepDriftHours - EPS;
    });
    auto.sleepEnergy = consecutive(i, S.sleepDriftNights, function (j) {
      const v = ser.sleep[j], b = rows[j].base.sleep, en = ser.energy[j];
      return v !== null && b !== null && en !== null && v <= b - S.sleepDriftHours + EPS && en >= S.energyHigh - EPS;
    });
    auto.bed = consecutive(i, S.bedtimeDriftNights, function (j) {
      const v = ser.bed[j], b = rows[j].base.bed;
      return v !== null && b !== null && v - b >= S.bedtimeDriftHours - EPS;
    });
    function speedRun(label) {
      let count = 0;
      for (let k = Math.max(0, i - 2); k <= i; k++) { if (rows[k].speed === label) count++; }
      return r.speed === label && count >= Math.round(S.racingDays);
    }
    auto.racing = speedRun(VAL.RACING);
    auto.slowed = speedRun(VAL.SLOWED);
    auto.med = r.med === VAL.NO;

    const active = { Early: {}, Middle: {}, Late: {} };
    signRows.forEach(function (row) {
      if (!active[row.tier] || !row.sign) return;
      let hit = false;
      switch (row.detector) {
        case DETECTORS.CHECKLIST: hit = r._checklistText.indexOf(row.sign) !== -1; break;
        case DETECTORS.ANSWER: hit = answerHit(row.detail, r.fields); break;
        case DETECTORS.SPIKE_KIND: hit = kindHit(row.detail, r._s.kinds); break;
        case DETECTORS.SPIKE_REPLAY: hit = r._s.replay; break;
        case DETECTORS.SPIKE_VERDICT: hit = r._s.verdict; break;
        case DETECTORS.SPIKE_DEBT: hit = r._s.debt; break;
        case DETECTORS.SPIKE_HOPELESS: hit = r._s.hopeless; break;
        case DETECTORS.SPIKE_URGE: hit = r._s.urge; break;
        case DETECTORS.KEYWORD: hit = !!S.keywordScanOn && keywordHit(row.detail, r._blob); break;
        case DETECTORS.A_SLEEP: hit = auto.sleep; break;
        case DETECTORS.A_RACING: hit = auto.racing; break;
        case DETECTORS.A_MED: hit = auto.med; break;
        case DETECTORS.A_SLOWED: hit = auto.slowed; break;
        case DETECTORS.A_OVERSLEEP: hit = auto.oversleep; break;
        case DETECTORS.A_SLEEPENERGY: hit = auto.sleepEnergy; break;
        case DETECTORS.A_MOOD_UP: hit = auto.moodUp; break;
        case DETECTORS.A_MOOD_DOWN: hit = auto.moodDown; break;
        case DETECTORS.A_BED: hit = auto.bed; break;
      }
      if (hit) active[row.tier][row.sign] = true;
    });
    r.tierCounts = {};
    r.activeSigns = [];
    const parts = [];
    TIERS.forEach(function (t) {
      const names = Object.keys(active[t]);
      r.tierCounts[t] = names.length;
      names.forEach(function (nm) { r.activeSigns.push({ tier: t, sign: nm }); });
      if (names.length) parts.push(t + ': ' + names.join('; '));
    });
    r.signsText = parts.join(' | ');
  });

  return { rows: rows, start: start, end: end };
}

/** Counts over the last `windowDays` rows. multi = days with signs in two or more tiers. */
function stackingSummary(rows, windowDays) {
  const last = rows.slice(-Math.max(1, Math.round(windowDays)));
  const out = { days: last.length, Early: 0, Middle: 0, Late: 0, multi: 0 };
  last.forEach(function (r) {
    let tiersHit = 0;
    TIERS.forEach(function (t) {
      if (r.tierCounts[t] > 0) { out[t]++; tiersHit++; }
    });
    if (tiersHit >= 2) out.multi++;
  });
  return out;
}

/** Newest first. gap = intensity minus trigger rating, both 0 to 10. */
function spikeList(spikes, limit) {
  return spikes.slice().sort(function (a, b) { return b.ts - a.ts; }).slice(0, limit || 8).map(function (g) {
    const f = num_(g.intensity), e = num_(g.event);
    return {
      date: g.date, kind: g.kind, feeling: f, event: e,
      gap: f !== null && e !== null ? f - e : null,
      fact: g.fact, replay: g.replay, debt: g.debt, hopeless: g.hopeless, urge: g.urge
    };
  });
}

/**
 * Days per answer for each categorical check-in question in a date range.
 * Returns [{field, total, answers:[{value, days}]}] in ANSWER_KEYS order.
 */
function answerCounts(rows, startDate, endDate) {
  return ANSWER_KEYS.map(function (k) {
    const title = HEADERS[k];
    const tally = {};
    let total = 0;
    rows.forEach(function (r) {
      if (r.date < startDate || r.date > endDate) return;
      const v = r.fields && r.fields[title];
      if (!v) return;
      tally[v] = (tally[v] || 0) + 1;
      total++;
    });
    const answers = Object.keys(tally).sort(function (a, b) { return tally[b] - tally[a]; })
      .map(function (v) { return { value: v, days: tally[v] }; });
    return { field: title, total: total, answers: answers };
  });
}

/** Days with data, mean, min, max of a row field between two dates inclusive. */
function statsFor(rows, field, startDate, endDate) {
  let n = 0, sum = 0, min = null, max = null;
  rows.forEach(function (r) {
    if (r.date < startDate || r.date > endDate) return;
    const v = r[field];
    if (v === null || v === undefined || v === '') return;
    n++; sum += v;
    if (min === null || v < min) min = v;
    if (max === null || v > max) max = v;
  });
  return { n: n, mean: n ? sum / n : null, min: min, max: max };
}

/** How many days each sign was active in a date range, with first and last day. */
function signTally(rows, startDate, endDate) {
  const map = {};
  rows.forEach(function (r) {
    if (r.date < startDate || r.date > endDate) return;
    r.activeSigns.forEach(function (a) {
      const key = a.tier + '\u0000' + a.sign;
      const e = map[key] || (map[key] = { tier: a.tier, sign: a.sign, days: 0, first: r.date, last: r.date });
      e.days++;
      e.last = r.date;
    });
  });
  return Object.keys(map).map(function (k) { return map[k]; }).sort(function (a, b) {
    return TIERS.indexOf(a.tier) - TIERS.indexOf(b.tier) || b.days - a.days;
  });
}

// ---- ReportModel.gs ----
/**
 * Reporting engine, pure part. No Apps Script services are used here, so this
 * file runs under Node for tests. Report.gs renders what this file builds.
 *
 * A report is: a date range, a set of sections, and a few privacy switches.
 * An audience is only a preset for those. The dialog fills the switches from
 * the preset and the user can change any of them before running.
 */

const REPORT_SECTIONS = [
  { key: 'coverage', label: 'Coverage' },
  { key: 'measures', label: 'Measures' },
  { key: 'charts', label: 'Charts' },
  { key: 'signs', label: 'Warning signs logged' },
  { key: 'answers', label: 'Check-in answers' },
  { key: 'spikes', label: 'Spikes' },
  { key: 'notes', label: 'Notes marked for sharing' }
];

const REPORT_AUDIENCES = [
  {
    key: 'psychiatrist', label: 'Psychiatrist or prescriber', death: true,
    sections: { coverage: true, measures: true, charts: true, signs: true, answers: true, spikes: true, notes: true }
  },
  {
    key: 'therapist', label: 'Therapist or counselor', death: true,
    sections: { coverage: true, measures: true, charts: true, signs: true, answers: true, spikes: true, notes: true }
  },
  {
    key: 'primary', label: 'Primary care or other clinician', death: false,
    sections: { coverage: true, measures: true, charts: true, signs: false, answers: false, spikes: false, notes: false }
  },
  {
    key: 'custom', label: 'Custom', death: false,
    sections: { coverage: true, measures: true, charts: false, signs: false, answers: false, spikes: false, notes: false }
  }
];

/** Chart titles (from chartSpecs_) used in reports. Bedtime and wake is left out. Its clock axis does not read well as an image. */
const REPORT_CHART_TITLES = [
  'Mood, 1 to 5', 'Sleep, hours', 'Energy, 1 to 5', 'Signs logged per day, by tier',
  'Steps (device)', 'Exercise, minutes (device)'
];

function audienceByKey(key) {
  for (let i = 0; i < REPORT_AUDIENCES.length; i++) { if (REPORT_AUDIENCES[i].key === key) return REPORT_AUDIENCES[i]; }
  return REPORT_AUDIENCES[0];
}

/**
 * raw: values from the dialog. S: normalized settings. today: 'YYYY-MM-DD'.
 * A custom date range wins over weeks. The range is clamped to today and to two years.
 */
function normalizeReportOpts(raw, S, today) {
  raw = raw || {};
  const aud = audienceByKey(raw.audience);
  const sections = {};
  REPORT_SECTIONS.forEach(function (s) {
    sections[s.key] = raw.sections && raw.sections[s.key] !== undefined ? !!raw.sections[s.key] : !!aud.sections[s.key];
  });
  let end = today;
  let start = null;
  const okDate = function (d) { return /^\d{4}-\d{2}-\d{2}$/.test(String(d || '')) && !isNaN(parseISO_(d)); };
  if (okDate(raw.from) && okDate(raw.to) && raw.from <= raw.to) {
    start = raw.from;
    end = raw.to > today ? today : raw.to;
    if (start > end) start = end;
  } else {
    let weeks = Math.round(Number(raw.weeks));
    if (!(weeks > 0)) weeks = Math.round(Number(S && S.summaryWeeks)) || 8;
    if (weeks > 104) weeks = 104;
    start = addDays(end, -(weeks * 7 - 1));
  }
  if (daysBetween(start, end) > 730) start = addDays(end, -730);
  const fmt = String(raw.format || 'doc');
  return {
    audience: aud.key,
    audienceLabel: aud.label,
    start: start,
    end: end,
    days: daysBetween(start, end) + 1,
    sections: sections,
    includeDeath: raw.includeDeath !== undefined ? !!raw.includeDeath : !!aud.death,
    includeText: !!raw.includeText,
    format: fmt === 'pdf' || fmt === 'csv' ? fmt : 'doc'
  };
}

/** Plain-language lines about what was left out, for the report footer. */
function reportRedactions(opts) {
  const out = [];
  if (opts.sections.notes) out.push('Only notes marked for sharing are included.');
  else out.push('Notes are not included.');
  if (opts.sections.spikes) out.push('The one-line text of spikes is not included.');
  if (opts.sections.answers && !opts.includeDeath) out.push('The answer to the question on thoughts of death is not included.');
  return out;
}

/**
 * data: { rows: daily rows, spikes, checkins, baselineDays }.
 * Returns the content of each enabled section. Sections that are off are null.
 */
function buildReportModel(data, opts) {
  const rows = data.rows.filter(function (r) { return r.date >= opts.start && r.date <= opts.end; });
  const recentStart = addDays(opts.end, -13);
  const model = { opts: opts, rows: rows, coverage: null, measures: null, signs: null, answers: null, spikes: null, notes: null, charts: null };

  if (opts.sections.coverage) {
    model.coverage = {
      days: rows.length,
      withEntry: rows.filter(function (r) { return r.entries > 0; }).length,
      missedMed: rows.filter(function (r) { return r.med === VAL.NO; }).length
    };
  }

  if (opts.sections.measures) {
    const defs = [
      ['Mood, 1 to 5', 'mood'], ['Sleep, hours, self-report', 'sleepSelf'], ['Sleep, hours, device', 'sleepDev'],
      ['Energy, 1 to 5', 'energy'], ['Steps, device', 'steps'], ['Exercise, minutes, device', 'exercise']
    ];
    model.measures = [];
    defs.forEach(function (m) {
      const all = statsFor(rows, m[1], opts.start, opts.end);
      if (!all.n) return;
      const recent = statsFor(rows, m[1], recentStart, opts.end);
      model.measures.push({ label: m[0], n: all.n, mean: all.mean, min: all.min, max: all.max, recentMean: recent.mean });
    });
  }

  if (opts.sections.signs) {
    model.signs = {
      tally: signTally(rows, opts.start, opts.end),
      multiDays: rows.filter(function (r) {
        return TIERS.filter(function (t) { return r.tierCounts[t] > 0; }).length >= 2;
      }).map(function (r) { return r.date; })
    };
  }

  if (opts.sections.answers) {
    model.answers = answerCounts(data.rows, opts.start, opts.end).filter(function (f) {
      if (f.total === 0) return false;
      if (!opts.includeDeath && f.field === HEADERS.death) return false;
      return true;
    });
  }

  if (opts.sections.spikes) {
    model.spikes = spikeList(data.spikes.filter(function (g) { return g.date >= opts.start && g.date <= opts.end; }), 500).reverse();
  }

  if (opts.sections.notes) {
    model.notes = data.checkins.filter(function (c) { return c.share && c.note && c.date >= opts.start && c.date <= opts.end; })
      .sort(function (a, b) { return a.ts - b.ts; })
      .map(function (c) { return { date: c.date, text: c.note }; });
  }

  if (opts.sections.charts) model.charts = REPORT_CHART_TITLES.slice();
  return model;
}

// ---------- CSV ----------

/**
 * One CSV cell. Text starting with = + - @ or a tab is prefixed with an
 * apostrophe so a spreadsheet does not run it as a formula. Numbers pass through.
 */
function csvCell(v) {
  if (v === null || v === undefined) return '';
  if (v instanceof Date) return v.toISOString();
  let s = typeof v === 'number' ? String(v) : String(v);
  if (typeof v !== 'number' && /^[=+\-@\t]/.test(s)) s = "'" + s;
  if (/[",\r\n]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
  return s;
}

function toCsv(header, rows) {
  const lines = [header.map(csvCell).join(',')];
  rows.forEach(function (r) { lines.push(r.map(csvCell).join(',')); });
  return lines.join('\r\n') + '\r\n';
}

/** Daily rows in range, using the same columns as the Daily tab. */
function dailyCsv(rows, opts) {
  const cols = dailyCols_().filter(function (c) { return opts.includeDeath || c.label !== HEADERS.death; });
  const inRange = rows.filter(function (r) { return r.date >= opts.start && r.date <= opts.end; });
  return toCsv(cols.map(function (c) { return c.label; }), inRange.map(function (r) {
    return cols.map(function (c) { return c.get(r); });
  }));
}

/** Raw check-ins in range. A note is included when it was marked for sharing, or when includeText is on. */
function checkinsCsv(checkins, opts) {
  const answerKeys = ANSWER_KEYS.filter(function (k) { return opts.includeDeath || k !== 'death'; });
  const header = ['Date', 'Submitted', 'Mood', 'Hours slept', 'Medication taken', 'Energy']
    .concat(answerKeys.map(function (k) { return HEADERS[k]; }))
    .concat(['Caffeine and alcohol', 'Signs I noticed', 'Note']);
  const inRange = checkins.filter(function (c) { return c.date >= opts.start && c.date <= opts.end; })
    .sort(function (a, b) { return a.ts - b.ts; });
  return toCsv(header, inRange.map(function (c) {
    const showNote = c.share || opts.includeText;
    return [c.date, c.ts, c.mood, c.sleep, c.med, c.energy]
      .concat(answerKeys.map(function (k) { return (c.answers || {})[HEADERS[k]] || ''; }))
      .concat([c.subst, c.signsText, showNote ? c.note : '']);
  }));
}

/** Spikes in range. The one-line text is included only when includeText is on. */
function spikesCsv(spikes, opts) {
  const header = ['Date', 'Submitted', 'Kind', 'Intensity', 'Trigger rating', 'Gap', 'Fact named', 'What the thought is saying',
    'Replay', 'Debt framing', 'Will not change', 'Urge', 'What happened'];
  const inRange = spikes.filter(function (g) { return g.date >= opts.start && g.date <= opts.end; })
    .sort(function (a, b) { return a.ts - b.ts; });
  return toCsv(header, inRange.map(function (g) {
    const f = num_(g.intensity), e = num_(g.event);
    return [g.date, g.ts, g.kind, g.intensity, g.event, f !== null && e !== null ? f - e : '', g.fact, g.frame,
      g.replay, g.debt, g.hopeless, g.urge, opts.includeText ? g.what : ''];
  }));
}

function signsCsv(rows, opts) {
  return toCsv(['Tier', 'Sign', 'Days', 'First', 'Last'], signTally(rows, opts.start, opts.end).map(function (e) {
    return [e.tier, e.sign, e.days, e.first, e.last];
  }));
}

/** A plain text note that goes in the CSV bundle. */
function csvAboutText(opts, generated) {
  const lines = [
    'Lodestone export',
    'Range: ' + opts.start + ' to ' + opts.end + ' (' + opts.days + ' days)',
    'Generated: ' + generated,
    '',
    'daily.csv      One row per calendar date. Days with no entry are blank, not zero. Baselines are rolling means of earlier days.',
    'check-ins.csv  One row per form submission.',
    'spikes.csv     One row per spike logged.',
    'signs.csv      Days each warning sign was active in the range.',
    '',
    'Values are self-reported unless a column says device.',
    opts.includeText ? 'Free text is included.' : 'Free text is not included, except check-in notes marked for sharing.'
  ];
  if (!opts.includeDeath) lines.push('The answer to the question on thoughts of death is not included.');
  return lines.join('\r\n') + '\r\n';
}

// ---- Forms.gs ----
/**
 * Form definitions. Edit the two field lists to change what the forms ask,
 * then run Journal > Update forms. Fields missing from an existing form are
 * appended at the end. Existing fields are never edited or removed.
 *
 * Titles come from HEADERS in Config.gs, so the response columns match what
 * the Logic reads. A new field is captured in the raw response tab
 * automatically. Showing it on Daily or Pattern needs a change in Logic.gs.
 *
 * Field types: scale, choice, checkbox, text, paragraph, page.
 * A choice may route: goTo 'submit' ends the form, goTo '<page id>' jumps to that page.
 */

function opts_(labels) { return labels.map(function (l) { return { label: l }; }); }

function checkinFields_(signNames) {
  const fields = [
    { id: 'mood', type: 'scale', title: HEADERS.mood, min: 1, max: 5, low: 'Low', high: 'High', help: '1 low, 3 level, 5 high', required: true },
    { id: 'sleep', type: 'text', title: HEADERS.sleep, number: [0, 24], help: 'Decimals are fine.', required: true },
    { id: 'med', type: 'choice', title: HEADERS.med, choices: [{ label: VAL.YES }, { label: VAL.NO }], required: true },
    { id: 'note', type: 'paragraph', title: HEADERS.note, required: false },
    { id: 'share', type: 'checkbox', title: HEADERS.share, choices: [{ label: VAL.YES }], help: 'Left blank counts as no.', required: false },
    {
      id: 'next', type: 'choice', title: HEADERS.next, required: true,
      choices: [{ label: VAL.NEXT_SUBMIT, goTo: 'submit' }, { label: VAL.NEXT_DETAIL, goTo: 'detail' }]
    },
    { id: 'detail', type: 'page', title: 'Detail', help: 'Everything on this page is optional. Skip any of it.' },
    { id: 'energy', type: 'scale', title: HEADERS.energy, min: 1, max: 5, low: 'Low', high: 'High', help: '1 low, 3 usual, 5 high', required: false },
    { id: 'speed', type: 'choice', title: HEADERS.speed, choices: opts_(VAL.SPEEDS), required: false },
    { id: 'interest', type: 'choice', title: HEADERS.interest, choices: opts_(VAL.LEVELS_UPDOWN), required: false },
    { id: 'talk', type: 'choice', title: HEADERS.talk, choices: opts_(VAL.TALK), required: false },
    { id: 'confidence', type: 'choice', title: HEADERS.confidence, choices: opts_(VAL.CONFIDENCE), required: false },
    { id: 'focus', type: 'choice', title: HEADERS.focus, choices: opts_(VAL.FOCUS), required: false },
    { id: 'irritability', type: 'choice', title: HEADERS.irritability, choices: opts_(VAL.LEVELS), required: false },
    { id: 'anxiety', type: 'choice', title: HEADERS.anxiety, choices: opts_(VAL.LEVELS), required: false },
    { id: 'hopeless', type: 'choice', title: HEADERS.hopeless, choices: opts_(VAL.LEVELS), required: false },
    { id: 'guilt', type: 'choice', title: HEADERS.guilt, choices: opts_(VAL.LEVELS), required: false },
    { id: 'impulse', type: 'choice', title: HEADERS.impulse, choices: opts_(VAL.LEVELS), required: false },
    { id: 'death', type: 'choice', title: HEADERS.death, choices: opts_(VAL.DEATH), required: false },
    { id: 'appetite', type: 'choice', title: HEADERS.appetite, choices: opts_(VAL.APPETITES), required: false },
    { id: 'substances', type: 'checkbox', title: HEADERS.substances, choices: opts_(VAL.SUBSTANCES), required: false }
  ];
  if (signNames && signNames.length) {
    fields.push({
      id: 'signs', type: 'checkbox', title: HEADERS.signs, help: 'The list comes from the Config tab.',
      choices: signNames.map(function (l) { return { label: l }; }), required: false
    });
  }
  return fields;
}

function spikeFields_() {
  const yn = opts_([VAL.YES, VAL.NO]);
  return [
    { id: 's_kind', type: 'choice', title: HEADERS.s_kind, choices: opts_(VAL.SPIKE_KINDS), required: true },
    { id: 's_what', type: 'text', title: HEADERS.s_what, required: true },
    { id: 's_intensity', type: 'scale', title: HEADERS.s_intensity, min: 0, max: 10, low: 'None', high: 'As strong as it gets', required: true },
    { id: 's_event', type: 'scale', title: HEADERS.s_event, min: 0, max: 10, low: 'None or trivial', high: 'Severe', help: 'Rate the trigger, not the feeling. 0 if there is none.', required: true },
    { id: 's_fact', type: 'choice', title: HEADERS.s_fact, choices: opts_([VAL.FACT_YES, VAL.FACT_NO, VAL.FACT_NONE]), required: false },
    { id: 's_frame', type: 'choice', title: HEADERS.s_frame, choices: opts_([VAL.FRAME_VERDICT, VAL.FRAME_ACCOUNT, VAL.FRAME_NONE]), required: false },
    { id: 's_replay', type: 'choice', title: HEADERS.s_replay, choices: yn, required: false },
    { id: 's_debt', type: 'choice', title: HEADERS.s_debt, choices: yn, required: false },
    { id: 's_hopeless', type: 'choice', title: HEADERS.s_hopeless, choices: yn, required: false },
    { id: 's_urge', type: 'choice', title: HEADERS.s_urge, choices: yn, required: false }
  ];
}

function applyFormSettings_(form, description) {
  form.setDescription(description);
  form.setConfirmationMessage('Saved.');
  form.setAllowResponseEdits(false);
  form.setPublishingSummary(false);
  form.setShowLinkToRespondAgain(false);
  form.setProgressBar(false);
  form.setCollectEmail(false);
}

/** Adds the given field definitions to the end of a form. */
function addFields_(form, defs) {
  const pages = {};
  const routed = [];
  defs.forEach(function (f) {
    if (f.type === 'page') {
      const pb = form.addPageBreakItem().setTitle(f.title);
      if (f.help) pb.setHelpText(f.help);
      pages[f.id] = pb;
      return;
    }
    let item;
    switch (f.type) {
      case 'scale':
        item = form.addScaleItem().setBounds(f.min, f.max).setLabels(f.low || '', f.high || '');
        break;
      case 'choice': item = form.addMultipleChoiceItem(); break;
      case 'checkbox': item = form.addCheckboxItem(); break;
      case 'paragraph': item = form.addParagraphTextItem(); break;
      case 'text':
        item = form.addTextItem();
        if (f.number) {
          item.setValidation(FormApp.createTextValidation()
            .setHelpText('Enter a number from ' + f.number[0] + ' to ' + f.number[1] + '.')
            .requireNumberBetween(f.number[0], f.number[1])
            .build());
        }
        break;
      default: throw new Error('Unknown field type: ' + f.type);
    }
    item.setTitle(f.title);
    if (f.help) item.setHelpText(f.help);
    item.setRequired(!!f.required);
    if (f.type === 'choice' || f.type === 'checkbox') {
      const hasRoute = f.choices.some(function (c) { return c.goTo; });
      if (hasRoute) routed.push({ item: item, f: f });
      else item.setChoiceValues(f.choices.map(function (c) { return c.label; }));
    }
  });
  // Routed choices are set last so the page they point to already exists.
  routed.forEach(function (r) {
    r.item.setChoices(r.f.choices.map(function (c) {
      if (c.goTo === 'submit') return r.item.createChoice(c.label, FormApp.PageNavigationType.SUBMIT);
      if (c.goTo && pages[c.goTo]) return r.item.createChoice(c.label, pages[c.goTo]);
      return r.item.createChoice(c.label);
    }));
  });
}

function createCheckinForm_(signNames) {
  const form = FormApp.create('Check-in');
  applyFormSettings_(form, 'Mood, sleep, medication. The detail page is optional.');
  addFields_(form, checkinFields_(signNames));
  return form;
}

function createSpikeForm_() {
  const form = FormApp.create('Log a spike');
  applyFormSettings_(form, 'Use when it happens. Not a daily form.');
  addFields_(form, spikeFields_());
  return form;
}

function formTitles_(form) {
  const t = {};
  form.getItems().forEach(function (it) { t[it.getTitle()] = it; });
  return t;
}

/**
 * Appends fields the form does not have yet and syncs the signs checklist
 * with the Config tab. Run from Journal > Update forms.
 * Returns a short report string.
 */
function updateForms() {
  const ss = getSS_();
  const props = PropertiesService.getScriptProperties();
  const cfg = readConfig_(ss);
  const signNames = checklistSigns_(cfg.signs);
  const report = [];

  const ciId = props.getProperty(PROP.FORM_CHECKIN_ID);
  if (ciId) {
    const form = FormApp.openById(ciId);
    const have = formTitles_(form);
    const missing = checkinFields_(signNames).filter(function (f) { return f.type !== 'page' && f.id !== 'signs' && !have[f.title]; });
    if (missing.length) addFields_(form, missing);
    report.push('Check-in form: ' + missing.length + ' field(s) added.');
    report.push(syncSignsChecklist_(form, signNames));
  }
  const gId = props.getProperty(PROP.FORM_SPIKE_ID);
  if (gId) {
    const form = FormApp.openById(gId);
    const have = formTitles_(form);
    const missing = spikeFields_().filter(function (f) { return !have[f.title]; });
    if (missing.length) addFields_(form, missing);
    report.push('Spike form: ' + missing.length + ' field(s) added.');
  }
  const text = report.join('\n');
  try { SpreadsheetApp.getUi().alert('Update forms', text, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) { /* no UI */ }
  return text;
}

/** Sets the "Signs I noticed" checkbox choices from the Config tab. */
function syncSignsChecklist_(form, signNames) {
  const have = formTitles_(form);
  const item = have[HEADERS.signs];
  if (!signNames.length) {
    return item ? 'Signs checklist: Config has no "Checklist tick" signs. The form item was left as it is.' : 'Signs checklist: none configured.';
  }
  if (item) {
    item.asCheckboxItem().setChoiceValues(signNames);
    return 'Signs checklist: updated to ' + signNames.length + ' item(s).';
  }
  addFields_(form, [{
    id: 'signs', type: 'checkbox', title: HEADERS.signs, help: 'The list comes from the Config tab.',
    choices: signNames.map(function (l) { return { label: l }; }), required: false
  }]);
  return 'Signs checklist: added with ' + signNames.length + ' item(s).';
}

/** Unique sign names that use the checklist, in Config order. */
function checklistSigns_(signs) {
  const seen = {};
  const out = [];
  signs.forEach(function (s) {
    if (s.detector === DETECTORS.CHECKLIST && !seen[s.sign]) { seen[s.sign] = true; out.push(s.sign); }
  });
  return out;
}

// ---- Sheet.gs ----
/**
 * Spreadsheet helpers and the static tabs (Config, Baseline).
 * Pattern and Daily are written by Refresh.gs.
 */

/** The journal spreadsheet. Uses the stored ID so triggers and web apps find it too. */
function getSS_() {
  const id = PropertiesService.getScriptProperties().getProperty(PROP.SHEET_ID);
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function getOrCreateSheet_(ss, name) {
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function styleHeader_(range) {
  range.setFontWeight('bold').setBackground('#F1F3F5').setFontColor('#1B1F23');
}

function styleTable_(range) {
  range.setBorder(true, true, true, true, true, true, '#D5D9DD', SpreadsheetApp.BorderStyle.SOLID);
}

/** Config tab. Written once. Existing cells are never overwritten, only missing settings are added. */
function buildConfigTab_(ss) {
  let sh = ss.getSheetByName(TABS.CONFIG);
  const fresh = !sh;
  if (!sh) sh = ss.insertSheet(TABS.CONFIG);
  const L = CFG_LAYOUT;

  sh.getRange('A1').setValue('Config').setFontSize(18).setFontWeight('bold');
  sh.getRange('A2').setValue('The warning signature and the response steps live here. The rows below are examples. Replace them with your own. Response steps are blank on purpose.');
  sh.getRange('A3').setValue('Do not insert rows above the tables. Add signs in the empty rows of the Signs table.');
  sh.getRange('A2:A3').setFontColor('#565F68');

  sh.getRange(L.signsLabelRow, 1).setValue('Signs').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.signsHeaderRow, 1, 1, 5).setValues([['Tier', 'Sign', 'Detected by', 'Detail', 'Note']]);
  styleHeader_(sh.getRange(L.signsHeaderRow, 1, 1, 5));
  styleTable_(sh.getRange(L.signsHeaderRow, 1, L.signsRows + 1, 5));

  sh.getRange(L.stepsLabelRow, 1).setValue('Response steps').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.stepsHeaderRow, 1, 1, 2).setValues([['Tier', 'Step']]);
  styleHeader_(sh.getRange(L.stepsHeaderRow, 1, 1, 2));
  sh.getRange(L.stepsFirstRow, 1, 3, 1).setValues([['Early'], ['Middle'], ['Late']]);
  styleTable_(sh.getRange(L.stepsHeaderRow, 1, 4, 2));
  sh.getRange(L.stepsFirstRow, 2, 3, 1).setWrap(true);
  sh.getRange(L.stepsFirstRow + 3, 1).setValue('Left blank. Write these with your clinician.').setFontColor('#565F68');

  sh.getRange(L.settingsLabelRow, 2).setValue('Settings').setFontWeight('bold').setFontSize(12);
  sh.getRange(L.settingsHeaderRow, 2, 1, 2).setValues([['Setting', 'Value']]);
  styleHeader_(sh.getRange(L.settingsHeaderRow, 2, 1, 2));

  if (fresh) {
    sh.getRange(L.signsFirstRow, 1, SEED_SIGNS.length, 5).setValues(SEED_SIGNS);
  }
  ensureSettings_(sh);
  styleTable_(sh.getRange(L.settingsHeaderRow, 2, SETTINGS.length + 1, 2));

  const tierRule = SpreadsheetApp.newDataValidation().requireValueInList(TIERS, true).setAllowInvalid(false).build();
  sh.getRange(L.signsFirstRow, 1, L.signsRows, 1).setDataValidation(tierRule);
  const detectorRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(Object.keys(DETECTORS).map(function (k) { return DETECTORS[k]; }), true)
    .setAllowInvalid(false).build();
  sh.getRange(L.signsFirstRow, 3, L.signsRows, 1).setDataValidation(detectorRule);

  const onOff = SpreadsheetApp.newDataValidation().requireValueInList(['On', 'Off'], true).setAllowInvalid(false).build();
  SETTINGS.forEach(function (s, i) {
    if (s.key === 'keywordScan') sh.getRange(L.settingsFirstRow + i, 3).setDataValidation(onOff);
  });

  sh.setColumnWidth(1, 90);
  sh.setColumnWidth(2, 340);
  sh.setColumnWidth(3, 200);
  sh.setColumnWidth(4, 260);
  sh.setColumnWidth(5, 260);
  sh.setHiddenGridlines(true);
  return sh;
}

/** Adds any setting whose label is not in the Settings table yet. */
function ensureSettings_(sh) {
  const L = CFG_LAYOUT;
  const span = SETTINGS.length + 20;
  // Text format first, so a value like 04:00 is stored as text and not converted to a time.
  sh.getRange(L.settingsFirstRow, 3, span, 1).setNumberFormat('@');
  const labels = sh.getRange(L.settingsFirstRow, 2, span, 1).getValues().map(function (r) { return String(r[0]).trim(); });
  SETTINGS.forEach(function (s) {
    if (labels.indexOf(s.label) !== -1) return;
    const slot = labels.indexOf('');
    if (slot === -1) return;
    labels[slot] = s.label;
    sh.getRange(L.settingsFirstRow + slot, 2, 1, 2).setValues([[s.label, String(s.value)]]);
  });
}

/** Writes one setting value by key. Returns false if the label is not found. */
function setSetting_(ss, key, value) {
  const sh = ss.getSheetByName(TABS.CONFIG);
  if (!sh) return false;
  const def = SETTINGS.filter(function (s) { return s.key === key; })[0];
  if (!def) return false;
  const L = CFG_LAYOUT;
  const labels = sh.getRange(L.settingsFirstRow, 2, SETTINGS.length + 20, 1).getValues();
  for (let i = 0; i < labels.length; i++) {
    if (String(labels[i][0]).trim() === def.label) {
      sh.getRange(L.settingsFirstRow + i, 3).setNumberFormat('@').setValue(String(value));
      return true;
    }
  }
  return false;
}

/** Baseline tab: pinned text written while clear-headed. Never overwritten once the tab exists. */
function buildBaselineTab_(ss) {
  if (ss.getSheetByName(TABS.BASELINE)) return ss.getSheetByName(TABS.BASELINE);
  const sh = ss.insertSheet(TABS.BASELINE);
  sh.getRange('A1').setValue('Baseline').setFontSize(18).setFontWeight('bold');
  sh.getRange('A2').setValue('Written when clear-headed. Pinned here to read.').setFontColor('#565F68');
  sh.getRange('A4').setValue('Written on [date]').setFontColor('#565F68');
  sh.getRange('A5').setValue('[Paste your text here.]').setFontSize(14).setWrap(true).setVerticalAlignment('top');
  sh.setColumnWidth(1, 760);
  sh.setRowHeight(5, 320);
  sh.setHiddenGridlines(true);
  return sh;
}

/** Puts the tabs in a fixed order. Missing tabs are skipped. */
function orderTabs_(ss) {
  const order = [TABS.CHECKINS, TABS.SPIKES, TABS.DAILY, TABS.DEVICE, TABS.PATTERN, TABS.CONFIG, TABS.BASELINE, TABS.CHART];
  let pos = 1;
  order.forEach(function (name) {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    ss.setActiveSheet(sh);
    ss.moveActiveSheet(pos);
    pos++;
  });
  const pattern = ss.getSheetByName(TABS.PATTERN);
  if (pattern) ss.setActiveSheet(pattern);
}

/** Removes the default empty "Sheet1" if other tabs exist. */
function removeDefaultSheet_(ss) {
  const sh = ss.getSheetByName('Sheet1');
  if (sh && ss.getSheets().length > 1 && sh.getLastRow() === 0 && sh.getLastColumn() === 0) ss.deleteSheet(sh);
}

// ---- Refresh.gs ----
/**
 * Reads the raw tabs, runs the Logic, writes Daily and Pattern.
 * Raw tabs (Check-ins, Spikes, Device) are never modified here.
 */

function refreshAll() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another refresh is running. Try again in a moment.');
  try {
    const data = loadAll_();
    writeDaily_(data);
    writePattern_(data);
    return data;
  } finally {
    lock.releaseLock();
  }
}

function refreshFromMenu() {
  refreshAll();
  getSS_().toast('Daily and Pattern refreshed.', 'Journal', 4);
}

/** Runs on every form submission. */
function handleFormSubmit() {
  try { refreshAll(); } catch (err) { console.error(String(err)); }
}

// ---------- reading ----------

function readTable_(sheet, display) {
  if (!sheet || sheet.getLastRow() < 2) return { idx: {}, rows: [] };
  const range = sheet.getDataRange();
  const values = display ? range.getDisplayValues() : range.getValues();
  const idx = {};
  values[0].forEach(function (h, i) { idx[String(h).trim()] = i; });
  return { idx: idx, rows: values.slice(1) };
}

function cell_(t, row, header) {
  const i = t.idx[header];
  return i === undefined ? '' : row[i];
}

function str_(v) { return v === null || v === undefined ? '' : String(v).trim(); }

/** The categorical check-in answers for one row, keyed by question title. Blanks are left out. */
function answers_(t, row) {
  const out = {};
  ANSWER_KEYS.forEach(function (k) {
    const v = str_(cell_(t, row, HEADERS[k]));
    if (v) out[HEADERS[k]] = v;
  });
  return out;
}

function readCheckins_(ss, rolloverHours, fmt) {
  const t = readTable_(ss.getSheetByName(TABS.CHECKINS), false);
  const out = [];
  t.rows.forEach(function (row) {
    const ts = cell_(t, row, HEADERS.timestamp);
    if (!(ts instanceof Date)) return;
    out.push({
      ts: ts,
      date: dateKey(ts, rolloverHours, fmt),
      mood: cell_(t, row, HEADERS.mood),
      sleep: cell_(t, row, HEADERS.sleep),
      med: str_(cell_(t, row, HEADERS.med)),
      energy: cell_(t, row, HEADERS.energy),
      answers: answers_(t, row),
      subst: str_(cell_(t, row, HEADERS.substances)),
      signsText: str_(cell_(t, row, HEADERS.signs)),
      note: str_(cell_(t, row, HEADERS.note)),
      share: str_(cell_(t, row, HEADERS.share)) === VAL.YES
    });
  });
  return out;
}

function readSpikes_(ss, rolloverHours, fmt) {
  const t = readTable_(ss.getSheetByName(TABS.SPIKES), false);
  const out = [];
  t.rows.forEach(function (row) {
    const ts = cell_(t, row, HEADERS.timestamp);
    if (!(ts instanceof Date)) return;
    out.push({
      ts: ts,
      date: dateKey(ts, rolloverHours, fmt),
      kind: str_(cell_(t, row, HEADERS.s_kind)),
      what: str_(cell_(t, row, HEADERS.s_what)),
      intensity: cell_(t, row, HEADERS.s_intensity),
      event: cell_(t, row, HEADERS.s_event),
      fact: str_(cell_(t, row, HEADERS.s_fact)),
      frame: str_(cell_(t, row, HEADERS.s_frame)),
      replay: str_(cell_(t, row, HEADERS.s_replay)),
      debt: str_(cell_(t, row, HEADERS.s_debt)),
      hopeless: str_(cell_(t, row, HEADERS.s_hopeless)),
      urge: str_(cell_(t, row, HEADERS.s_urge))
    });
  });
  return out;
}

function readDevice_(ss) {
  const sh = ss.getSheetByName(TABS.DEVICE);
  if (!sh) return [];
  const t = readTable_(sh, true);
  const H = DEVICE_HEADERS;
  const out = [];
  t.rows.forEach(function (row) {
    const date = str_(cell_(t, row, H.date));
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return;
    out.push({
      date: date,
      sleep: str_(cell_(t, row, H.sleep)),
      bed: str_(cell_(t, row, H.bed)),
      wake: str_(cell_(t, row, H.wake)),
      steps: str_(cell_(t, row, H.steps)),
      exercise: str_(cell_(t, row, H.exercise))
    });
  });
  return out;
}

function capTier_(v) {
  const s = str_(v).toLowerCase();
  for (let i = 0; i < TIERS.length; i++) { if (TIERS[i].toLowerCase() === s) return TIERS[i]; }
  return '';
}

function readConfig_(ss) {
  const out = { settings: normalizeSettings({}), signs: [], steps: {} };
  const sh = ss.getSheetByName(TABS.CONFIG);
  if (!sh) return out;
  const L = CFG_LAYOUT;
  sh.getRange(L.signsFirstRow, 1, L.signsRows, 5).getDisplayValues().forEach(function (r) {
    const tier = capTier_(r[0]);
    const sign = str_(r[1]);
    const detector = str_(r[2]);
    if (tier && sign && detector) out.signs.push({ tier: tier, sign: sign, detector: detector, detail: str_(r[3]) });
  });
  sh.getRange(L.stepsFirstRow, 1, 3, 2).getDisplayValues().forEach(function (r) { out.steps[str_(r[0])] = str_(r[1]); });
  const last = Math.max(sh.getLastRow(), L.settingsFirstRow);
  const raw = {};
  sh.getRange(L.settingsFirstRow, 2, last - L.settingsFirstRow + 1, 2).getDisplayValues().forEach(function (r) {
    const label = str_(r[0]);
    SETTINGS.forEach(function (s) { if (s.label === label) raw[s.key] = str_(r[1]); });
  });
  out.settings = normalizeSettings(raw);
  return out;
}

function loadAll_() {
  const ss = getSS_();
  const tz = ss.getSpreadsheetTimeZone();
  const cfg = readConfig_(ss);
  const fmt = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); };
  const rh = cfg.settings.rolloverHours;
  const checkins = readCheckins_(ss, rh, fmt);
  const spikes = readSpikes_(ss, rh, fmt);
  const device = readDevice_(ss);
  const today = dateKey(new Date(), rh, fmt);
  const daily = buildDaily({ checkins: checkins, spikes: spikes, device: device, signs: cfg.signs }, cfg.settings, today);
  return { ss: ss, tz: tz, cfg: cfg, checkins: checkins, spikes: spikes, device: device, today: today, daily: daily };
}

// ---------- Daily tab ----------

function dailyCols_() {
